<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <!-- Circular Always-On Speaker Button -->
    <FrameLayout
        android:id="@+id/btnHandle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle_button"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/ivHandleIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="Volume Button"
            android:src="@drawable/ic_volume" />
    </FrameLayout>

    <!-- Vertical Stack: + / - / Power -->
    <LinearLayout
        android:id="@+id/panelControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/btnVolUp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_button"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/ivVolUp"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Volume Up"
                android:src="@drawable/ic_plus" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnVolDown"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_circle_button"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/ivVolDown"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Volume Down"
                android:src="@drawable/ic_minus" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/btnPower"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_circle_power"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivPower"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Power Menu"
                android:src="@drawable/ic_power" />

            <TextView
                android:id="@+id/tvPowerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Power"
                android:textColor="@color/power_red_tint"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
